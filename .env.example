# Supabase (Project Settings → API)
# Nilai NEXT_PUBLIC_* akan terlihat di browser. Itu normal untuk
# anon/publishable key; jangan pernah menaruh service_role / sb_secret di sini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (Google AI Studio)
# Hanya untuk server. Jangan pernah menambahkan prefix NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opsional; default gemini-3.8-flash. Ganti bila akun Anda memakai model lain.
GEMINI_MODEL=gemini-3.8-flash
